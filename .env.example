# CentrAlign AI Environment Configuration

# LLM Provider: 'gemini' (default), 'claude', 'openai', or 'fake'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Provide according to selected provider)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mode: 'intern' (Phase 0-5 core worker) or 'founding' (Phase 6-8 operator)
CENTRALIGN_MODE=founding

# Unified Mock Environment URL (Port 8001 by default)
MOCK_ENV_BASE_URL=http://localhost:8001
MOCK_ERP_URL=http://localhost:8001/erp
MOCK_VENDOR_PORTAL_URL=http://localhost:8001/portal
MOCK_MAILBOX_URL=http://localhost:8001/mail
MOCK_TICKETING_URL=http://localhost:8001/tickets
MOCK_FILESHARE_URL=http://localhost:8001/files
FILESHARE_DIR=./env/fileshare/data

# Execution & Policy Settings
MAX_STEPS_PER_RUN=30
APPROVAL_AMOUNT_THRESHOLD=50000
HEADLESS_BROWSER=true
